            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/dev.repost.admin.auth.TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "headers": {}
          },
          "429": {
            "description": "Rate limited",
            "headers": {}
          }
        },
        "deprecated": false
      }
    },
