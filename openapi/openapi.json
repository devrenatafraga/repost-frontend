    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Service is up",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "title": "String"
                  },
                  "title": "Map<String,String>"
                },
                "examples": {
                  "default": {
                    "value": {
                      "status": "ok"
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      }
    },
    "/api/v1/public/posts": {
      "get": {
        "tags": [
          "public"
        ],
        "summary": "List published posts",
        "description": "Anonymous list of published posts for the default blog, newest first.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Published posts",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/dev.repost.publicapi.posts.PublicPostListResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database or default blog unavailable",
            "headers": {}
          }
        },
        "deprecated": false
      }
    },
    "/api/v1/public/posts/{slug}": {
      "get": {
        "tags": [
          "public"
        ],
        "summary": "Get published post by slug",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "deprecated": false,
            "explode": false,
            "schema": {
              "type": "string",
              "title": "String"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Published post",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/dev.repost.publicapi.posts.PublicPostResponse"
                }
              }
            }
          },
          "404": {
            "description": "Missing or not published",
            "headers": {}
          },
          "503": {
            "description": "Database or default blog unavailable",
            "headers": {}
          }
        },
        "deprecated": false
      }
    },
    "/api/v1/public": {
      "get": {
        "tags": [
          "public"
        ],
        "summary": "Public API surface",
        "description": "Stub endpoint for the anonymous, cacheable public surface.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Surface metadata",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
